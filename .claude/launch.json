{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "yjsp-server",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "YJSP_DEV_AUTH=1",
        "YJSP_BOOTSTRAP_ADMINS=dev@yjsp.test",
        "uv",
        "run",
        "--directory",
        "server",
        "yjsp-server"
      ],
      "port": 8000
    },
    {
      "name": "yjsp-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
