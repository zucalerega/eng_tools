<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Vault-Setup.exe: one download that installs the SolidWorks add-in (and cvc-open.exe) in Program
         Files, registers it with SolidWorks and for cvc:// links, and can take it all away again from
         Windows' list of installed apps. It carries the add-in's files inside it (PackAddIn, below). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Vault-Setup</AssemblyName>
    <RootNamespace>Cvc.Setup</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built first, then packed in; setup doesn't load it. -->
    <ProjectReference Include="..\Cvc.SolidWorks\Cvc.SolidWorks.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- Vault's mark, drawn as the add-in draws its tab icon. -->
    <Compile Include="..\Cvc.SolidWorks\Icons.cs" Link="Icons.cs" />
  </ItemGroup>

  <!-- The add-in's build, without its debug symbols, zipped into this exe as the resource addin.zip. -->
  <Target Name="PackAddIn" AfterTargets="ResolveReferences" BeforeTargets="PrepareResources">
    <MSBuild Projects="..\Cvc.SolidWorks\Cvc.SolidWorks.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="AddInAssembly" />
    </MSBuild>
    <PropertyGroup>
      <AddInFolder>$([System.IO.Path]::GetDirectoryName('$(AddInAssembly)'))</AddInFolder>
      <AddInStage>$(IntermediateOutputPath)addin\</AddInStage>
      <AddInZip>$(IntermediateOutputPath)addin.zip</AddInZip>
    </PropertyGroup>
    <ItemGroup>
      <AddInFile Include="$(AddInFolder)\**\*" Exclude="$(AddInFolder)\**\*.pdb" />
    </ItemGroup>
    <RemoveDir Directories="$(AddInStage)" />
    <Copy SourceFiles="@(AddInFile)" DestinationFiles="@(AddInFile->'$(AddInStage)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(AddInStage)" DestinationFile="$(AddInZip)" Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(AddInZip)" LogicalName="addin.zip" />
    </ItemGroup>
  </Target>

</Project>
