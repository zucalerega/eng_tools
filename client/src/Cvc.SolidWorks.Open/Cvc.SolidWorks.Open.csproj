<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- cvc-open.exe follows cvc:// links (the web app's "Open in SolidWorks") by handing them to
         the add-in in SolidWorks. It ships in the add-in's folder; install.ps1 registers it. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>cvc-open</AssemblyName>
    <RootNamespace>Cvc.SolidWorks.Open</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
