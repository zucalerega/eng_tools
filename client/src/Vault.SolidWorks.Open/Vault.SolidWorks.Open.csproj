<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- vault-open.exe follows vault:// links (the web app's "Open in SolidWorks") by handing them to
         the add-in in SolidWorks. It ships in the add-in's folder; install.ps1 registers it. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Restore for win-x64 on every OS: Windows infers it for a 64-bit .NET Framework exe, and others don't,
         so without this packages.lock.json matches only one of them and CI's locked restore fails. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>vault-open</AssemblyName>
    <RootNamespace>Vault.SolidWorks.Open</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
