<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- SolidWorks 2025 loads add-ins as 64-bit .NET Framework 4.8 COM components. -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Vault.SolidWorks</RootNamespace>
    <!-- .NET Framework 4.8 doesn't have every API the implicit usings assume. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The add-in is loaded from its own folder, so everything it needs must be copied there. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- SolidWorks 2025 API (version 33) interop assemblies. -->
    <PackageReference Include="Visiativ.SOLIDWORKS.Interop" Version="33.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vault.Client\Vault.Client.csproj" />
    <!-- vault-open.exe: follows the web app's "Open in SolidWorks" links; it goes in the add-in's folder. -->
    <ProjectReference Include="..\Vault.SolidWorks.Open\Vault.SolidWorks.Open.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="install.ps1;uninstall.ps1;README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
