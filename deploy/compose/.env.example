# Your site's settings, for compose.yaml: copy this to .env (chmod 600: it has secrets), and fill it in.
# docs/self-hosting.md goes through each; the repository's server/.env.example has every setting there is.

# Which release to run: the latest one's tag, from https://github.com/zucalerega/eng_tools/releases. Upgrading is
# changing it (docs/self-hosting.md, "Upgrading").
YJSP_VERSION=v0.7.0
# Where people reach the site: a name whose DNS points at this machine, with ports 80 and 443 open to it. Caddy gets
# its HTTPS certificate on its own. Sign-in's redirect URIs are at it (docs/self-hosting.md, "Sign-in").
YJSP_DOMAIN=tools.example.edu
# A long random string, kept secret, which signs sign-in's cookies. Make one with:
#   openssl rand -base64 48
YJSP_SECRET_KEY=

# Whose site it is: a short name for the top bar and the tabs, and the team's. The team's logo goes in the volume
# (docs/self-hosting.md, "Your team's name and logo"); until it's there, the pages show the site's name instead.
YJSP_SITE_NAME=RPL
YJSP_TEAM_NAME=Rocket Propulsion Lab

# The school whose people join: what the pages call it, and its email domains (comma-separated; their subdomains
# count too). Only its addresses make an account by signing in; anyone else needs an admin's invite.
YJSP_SCHOOL_NAME=Purdue
YJSP_SCHOOL_DOMAINS=purdue.edu

# At least one way to sign in (docs/self-hosting.md, "Sign-in"): take the # off the lines you use.
# Microsoft, where the school's accounts are Microsoft 365's: the school's tenant ID, and the app's client ID and secret.
# YJSP_MICROSOFT_TENANT=00000000-0000-0000-0000-000000000000
# YJSP_MICROSOFT_CLIENT_ID=
# YJSP_MICROSOFT_CLIENT_SECRET=
# Google: the OAuth client's ID and secret. YJSP_GOOGLE_MAKES_ACCOUNTS=1 only where the school's accounts are Google's:
# then Google makes accounts for its addresses too. Otherwise Google signs in only people who are in already.
# YJSP_GOOGLE_CLIENT_ID=
# YJSP_GOOGLE_CLIENT_SECRET=
# YJSP_GOOGLE_MAKES_ACCOUNTS=1

# Who's an admin from their first sign-in: your own email, at least (comma-separated).
YJSP_BOOTSTRAP_ADMINS=you@purdue.edu

# The image, if not the published one: one built on this machine (docs/self-hosting.md, "Building the image").
# YJSP_IMAGE=yjsp-server
