# Where backup.sh copies the site's data, and the keys to it: copy this to backup.env (chmod 600), which only restic
# reads, never the server. docs/self-hosting.md, "Backups", has the steps.

# The restic repository (https://restic.readthedocs.io/en/stable/030_preparing_a_new_repo.html): a bucket in object
# storage, in Cloudflare R2 (as below), Backblaze B2, or Amazon S3.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/yjsp-backups
# Its password, which encrypts everything before it leaves this machine. Keep a copy in a password manager: without it
# no one can read the backups, you included. Make one with: openssl rand -base64 32
RESTIC_PASSWORD=
# The storage's keys: for R2, an API token's, with Object Read & Write on this bucket only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
