# /etc/yjsp/offsite.env on the server (root only: chmod 600), for yjsp-offsite: where YJSP's data is copied off the
# server, and the keys to it. See docs/deploying.md, "Backups". The real one never leaves the server.

# The restic repository: a Cloudflare R2 bucket, by the account's ID (R2's overview page).
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/yjsp-backups
# Its password, which encrypts everything: a file, so it never shows in a process list. Keep it in the owner's password
# manager too: without it nobody can read the backups, us included.
RESTIC_PASSWORD_FILE=/etc/yjsp/offsite.password
# An R2 API token's keys: Object Read & Write, for this bucket only. It can't change the bucket's lock rules.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
