#!/bin/bash
# /usr/local/sbin/vault-backup on the server, run each night by vault-backup.timer: see docs/deploying.md.
# Vault's database, copied each night with SQLite's own backup (whole and consistent while the server runs),
# kept for 14 days. The files (CAD versions, datasets) aren't copied: they need somewhere off this server.
set -euo pipefail
cd /srv/vault
stamp=$(date -u +%Y-%m-%d)
sqlite3 data/vault.db ".backup 'backups/vault-$stamp.db'"
gzip -f "backups/vault-$stamp.db"
find backups -name 'vault-*.db.gz' -mtime +14 -delete
