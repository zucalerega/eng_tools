# /etc/systemd/system/vault.service on the server: see docs/deploying.md. Keep this copy the same as the server's.
[Unit]
Description=Vault and Yorg (cvc-server)
Wants=network-online.target
After=network-online.target

[Service]
User=vault
Group=vault
# .env and data/ are here.
WorkingDirectory=/srv/vault
ExecStart=/opt/vault/app/server/.venv/bin/cvc-server
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/vault
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
