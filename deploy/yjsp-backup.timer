# /etc/systemd/system/yjsp-backup.timer on the server: see docs/deploying.md. Keep this copy the same as the server's.
[Unit]
Description=Back up the YJSP database each night

[Timer]
# 08:30 UTC: 4:30 in the morning in Atlanta.
OnCalendar=*-*-* 08:30:00
Persistent=true

[Install]
WantedBy=timers.target
