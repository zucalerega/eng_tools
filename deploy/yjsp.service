# /etc/systemd/system/yjsp.service on the server: see docs/deploying.md. Keep this copy the same as the server's.
[Unit]
Description=YJSP: Vault and Yorg (yjsp-server)
Wants=network-online.target
After=network-online.target

[Service]
User=yjsp
Group=yjsp
# .env and data/ are here.
WorkingDirectory=/srv/yjsp
ExecStart=/opt/yjsp/app/server/.venv/bin/yjsp-server
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/yjsp
LimitNOFILE=65536
# The server and its model runs together, on a 6 GB machine: past MemoryHigh the kernel reclaims its memory hard, and
# past MemoryMax systemd stops it (and Restart brings it back), rather than the kernel stopping whatever it picks, SSH
# and Tailscale included.
MemoryHigh=4G
MemoryMax=5G

[Install]
WantedBy=multi-user.target
