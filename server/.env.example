# Copy to server/.env for local settings. Every setting is in src/cvc_server/config.py.

# Local development: sign in as any email without Google (never in production).
CVC_DEV_AUTH=1
# These emails become admins when they sign in.
CVC_BOOTSTRAP_ADMINS=you@example.com

# Production (see docs/design.md, "Deploying"):
# CVC_ENV=production
# CVC_PUBLIC_URL=https://cvc.example.org
# CVC_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(48))">
# CVC_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# CVC_GOOGLE_CLIENT_SECRET=...
# CVC_DATABASE_URL=sqlite:////data/cvc.db
# CVC_BLOB_DIR=/data/blobs
# Where Vault-Setup.exe (CI's vault-setup artifact) is, for the web app's SolidWorks page:
# CVC_DOWNLOADS_DIR=/data/downloads
