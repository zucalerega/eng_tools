# Copy to server/.env for local settings. Every setting is in src/yjsp_server/config.py.

# Local development: sign in as any email without Google (never in production).
YJSP_DEV_AUTH=1
# These emails become admins when they sign in.
YJSP_BOOTSTRAP_ADMINS=you@example.com

# Production (see docs/design.md, "Deploying"):
# YJSP_ENV=production
# YJSP_PUBLIC_URL=https://yjsp.example.org
# YJSP_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(48))">
# YJSP_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# YJSP_GOOGLE_CLIENT_SECRET=...
# YJSP_DATABASE_URL=sqlite:////data/yjsp.db
# Vault's files (every version of every file, in blobs/). Back it up with the database:
# YJSP_VAULT_DIR=/data/vault
# Yorg's files (uploaded test data, the arrays read from it, saved scripts and models). Back it up too:
# YJSP_YORG_DIR=/data/yorg
# Where Vault-Setup.exe (CI's vault-setup artifact) is, for the web app's SolidWorks page:
# YJSP_DOWNLOADS_DIR=/data/downloads
